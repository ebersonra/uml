        <mxCell id="ueWTc41nONLPTZEmqJE3-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 18px;&quot; data-end=&quot;232&quot; data-start=&quot;193&quot;&gt;1. Estrutura Legal e Regulamentação&lt;/strong&gt;&lt;/h1&gt;&lt;p class=&quot;&quot; data-end=&quot;323&quot; data-start=&quot;235&quot;&gt;Antes de qualquer código, vamos garantir que o nosso app possa operar legalmente:&lt;/p&gt;&lt;ul data-end=&quot;605&quot; data-start=&quot;324&quot;&gt;&lt;li class=&quot;&quot; data-end=&quot;402&quot; data-start=&quot;324&quot;&gt;&lt;p class=&quot;&quot; data-end=&quot;402&quot; data-start=&quot;326&quot;&gt;&lt;strong data-end=&quot;349&quot; data-start=&quot;326&quot;&gt;Registro da empresa&lt;/strong&gt; em um país que permita operar contas de pagamento.&lt;/p&gt;&lt;/li&gt;&lt;li class=&quot;&quot; data-end=&quot;504&quot; data-start=&quot;403&quot;&gt;&lt;p class=&quot;&quot; data-end=&quot;504&quot; data-start=&quot;405&quot;&gt;&lt;strong data-end=&quot;444&quot; data-start=&quot;405&quot;&gt;Licença de Instituição de Pagamento&lt;/strong&gt; no país onde o app vai funcionar (no Brasil e/ou na China).&lt;/p&gt;&lt;/li&gt;&lt;li class=&quot;&quot; data-end=&quot;605&quot; data-start=&quot;505&quot;&gt;&lt;p class=&quot;&quot; data-end=&quot;605&quot; data-start=&quot;507&quot;&gt;&lt;strong data-end=&quot;582&quot; data-start=&quot;507&quot;&gt;Conformidade com KYC (Know Your Customer) e AML (Anti-Money Laundering)&lt;/strong&gt; para evitar fraudes.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#b85450;dashed=1;fillColor=#f8cecc;fontSize=18;fontFamily=Helvetica;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="160" y="480" width="920" height="280" as="geometry" />
        </mxCell>
        <mxCell id="ueWTc41nONLPTZEmqJE3-12" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;fontSize=12;startSize=8;endSize=8;" parent="1" source="ueWTc41nONLPTZEmqJE3-4" target="ueWTc41nONLPTZEmqJE3-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ueWTc41nONLPTZEmqJE3-4" value="&lt;h3 class=&quot;&quot; data-end=&quot;660&quot; data-start=&quot;612&quot;&gt;&lt;strong data-end=&quot;658&quot; data-start=&quot;616&quot;&gt;2. Infraestrutura Bancária e Parcerias&lt;/strong&gt;&lt;/h3&gt;&lt;h3 class=&quot;&quot; data-end=&quot;660&quot; data-start=&quot;612&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 18px;&quot; data-end=&quot;700&quot; data-start=&quot;663&quot;&gt;Abrir uma conta bancária na China&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 18px;&quot;&gt; para armazenar os fundos dos usuários.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 18px;&quot; data-end=&quot;795&quot; data-start=&quot;744&quot;&gt;Parceria com um banco ou instituição financeira&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 18px;&quot;&gt; que permita API de pagamento e conversão de moeda.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 18px;&quot; data-end=&quot;888&quot; data-start=&quot;851&quot;&gt;Integração com sistemas de câmbio&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 18px;&quot;&gt; para conversão automática de moedas.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h3&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#d6b656;dashed=1;fillColor=#fff2cc;fontSize=18;fontFamily=Helvetica;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="160" y="880" width="920" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ueWTc41nONLPTZEmqJE3-5" value="&lt;h3 class=&quot;&quot; data-end=&quot;660&quot; data-start=&quot;612&quot;&gt;&lt;/h3&gt;&lt;h2&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 18px;&quot;&gt;3. Arquitetura do Sistema&lt;/span&gt;&lt;/h2&gt;&lt;div&gt;&lt;p class=&quot;&quot; data-end=&quot;1020&quot; data-start=&quot;970&quot;&gt;O app precisará de alguns componentes básicos:&lt;/p&gt;&lt;ul data-end=&quot;1407&quot; data-start=&quot;1021&quot;&gt;&lt;li class=&quot;&quot; data-end=&quot;1104&quot; data-start=&quot;1021&quot;&gt;&lt;p class=&quot;&quot; data-end=&quot;1104&quot; data-start=&quot;1023&quot;&gt;&lt;strong data-end=&quot;1048&quot; data-start=&quot;1023&quot;&gt;Banco de Dados Seguro&lt;/strong&gt; para armazenar informações dos usuários e transações.&lt;/p&gt;&lt;/li&gt;&lt;li class=&quot;&quot; data-end=&quot;1168&quot; data-start=&quot;1105&quot;&gt;&lt;p class=&quot;&quot; data-end=&quot;1168&quot; data-start=&quot;1107&quot;&gt;&lt;strong data-end=&quot;1134&quot; data-start=&quot;1107&quot;&gt;Serviço de Autenticação&lt;/strong&gt; para login seguro (OAuth, JWT e FIDO).&lt;/p&gt;&lt;/li&gt;&lt;li class=&quot;&quot; data-end=&quot;1250&quot; data-start=&quot;1169&quot;&gt;&lt;p class=&quot;&quot; data-end=&quot;1250&quot; data-start=&quot;1171&quot;&gt;&lt;strong data-end=&quot;1208&quot; data-start=&quot;1171&quot;&gt;Sistema de Gerenciamento de Saldo&lt;/strong&gt; para controlar os valores dos usuários.&lt;/p&gt;&lt;/li&gt;&lt;li class=&quot;&quot; data-end=&quot;1331&quot; data-start=&quot;1251&quot;&gt;&lt;p class=&quot;&quot; data-end=&quot;1331&quot; data-start=&quot;1253&quot;&gt;&lt;strong data-end=&quot;1288&quot; data-start=&quot;1253&quot;&gt;Mecanismo de Conversão de Moeda&lt;/strong&gt; para calcular e aplicar taxas de câmbio.&lt;/p&gt;&lt;/li&gt;&lt;li class=&quot;&quot; data-end=&quot;1407&quot; data-start=&quot;1332&quot;&gt;&lt;p class=&quot;&quot; data-end=&quot;1407&quot; data-start=&quot;1334&quot;&gt;&lt;strong data-end=&quot;1355&quot; data-start=&quot;1334&quot;&gt;APIs de Pagamento&lt;/strong&gt; para realizar depósitos, saques e transferências.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#6c8ebf;dashed=1;fillColor=#dae8fc;fontSize=18;fontFamily=Helvetica;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="160" y="1220" width="920" height="340" as="geometry" />
